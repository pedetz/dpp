---
interface Props {
  value: number
}

const { value } = Astro.props
const clamped = Math.min(Math.max(value, 0), 100)
---

<div>
  <div class="flex items-baseline gap-1 mb-2">
    <span class="text-3xl font-bold text-[#1a4731]">{value}</span>
    <span class="text-lg font-semibold text-[#1a4731]">%</span>
  </div>
  <div class="w-full bg-gray-100 rounded-full h-2">
    <div
      class="bg-green-500 h-2 rounded-full"
      style={`width: ${clamped}%`}
      role="progressbar"
      aria-valuenow={value}
      aria-valuemin={0}
      aria-valuemax={100}
    />
  </div>
</div>
