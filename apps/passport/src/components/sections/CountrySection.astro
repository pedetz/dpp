---
import type { Lang } from '@/lib/i18n'

interface Props {
  countryCode: string
  lang: Lang
}

const { countryCode, lang } = Astro.props

const countryNames: Record<string, { it: string; en: string }> = {
  IT: { it: 'Italia', en: 'Italy' },
  FR: { it: 'Francia', en: 'France' },
  DE: { it: 'Germania', en: 'Germany' },
  PT: { it: 'Portogallo', en: 'Portugal' },
  TR: { it: 'Turchia', en: 'Turkey' },
  CN: { it: 'Cina', en: 'China' },
  IN: { it: 'India', en: 'India' },
  BD: { it: 'Bangladesh', en: 'Bangladesh' },
  VN: { it: 'Vietnam', en: 'Vietnam' },
  MA: { it: 'Marocco', en: 'Morocco' },
  TN: { it: 'Tunisia', en: 'Tunisia' },
  RO: { it: 'Romania', en: 'Romania' },
  HR: { it: 'Croazia', en: 'Croatia' },
  ME: { it: 'Montenegro', en: 'Montenegro' },
  RS: { it: 'Serbia', en: 'Serbia' },
  PL: { it: 'Polonia', en: 'Poland' },
}

function getFlagEmoji(code: string): string {
  const upper = code.toUpperCase()
  return upper
    .split('')
    .map((c) => String.fromCodePoint(0x1f1e6 + c.charCodeAt(0) - 65))
    .join('')
}

const code = countryCode.toUpperCase()
const nameEntry = countryNames[code]
const countryName = nameEntry ? nameEntry[lang] : countryCode
const flag = getFlagEmoji(code)
---

<div class="flex items-center gap-3 text-gray-800">
  <span class="text-3xl" aria-hidden="true">{flag}</span>
  <span class="text-base font-medium">{countryName}</span>
</div>
