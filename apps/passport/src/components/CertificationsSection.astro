---
import type { Lang } from '@/lib/i18n'
import { getTranslation } from '@/lib/i18n'

interface Certification {
  kind: string
  valid_until?: string
}

interface Props {
  certifications: Certification[]
  lang: Lang
}

const { certifications, lang } = Astro.props

const locale = lang === 'it' ? 'it-IT' : 'en-GB'

function formatDate(dateStr: string): string {
  return new Intl.DateTimeFormat(locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(new Date(dateStr))
}
---

{certifications.length > 0 && (
  <section class="bg-white rounded-lg shadow-sm mb-4 p-4">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">
      {getTranslation(lang, 'certifications_title')}
    </h2>
    <ul class="space-y-2">
      {certifications.map((cert) => (
        <li class="flex items-start justify-between gap-4 py-2 border-b border-gray-50 last:border-0">
          <span class="text-sm font-medium text-gray-800">{cert.kind}</span>
          {cert.valid_until && (
            <span class="text-xs text-gray-500 whitespace-nowrap">
              {getTranslation(lang, 'cert_valid_until')} {formatDate(cert.valid_until)}
            </span>
          )}
        </li>
      ))}
    </ul>
  </section>
)}
