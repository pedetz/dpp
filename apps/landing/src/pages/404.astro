---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
---

<Layout title="Pagina non trovata" description="La pagina che cerchi non esiste.">
  <Navbar />

  <main class="min-h-[70vh] flex items-center justify-center py-20">
    <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- 404 illustration -->
      <div class="mb-8">
        <div class="text-9xl font-extrabold text-primary-100 select-none leading-none">404</div>
        <div class="relative -mt-10 flex justify-center">
          <div class="w-24 h-24 bg-primary-50 rounded-2xl flex items-center justify-center shadow-md border border-primary-100">
            <svg class="w-12 h-12 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
        </div>
      </div>

      <h1 class="text-3xl font-bold text-gray-900 mb-4">Passaporto non trovato</h1>
      <p class="text-lg text-gray-500 mb-8 leading-relaxed">
        La pagina che cerchi non esiste o è stata spostata.<br />
        Prova a tornare alla home o esplora la demo.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary-600 text-white font-semibold rounded-xl hover:bg-primary-700 transition-colors shadow-sm"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Torna alla home
        </a>
        <a
          href="/demo"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white text-gray-700 font-semibold rounded-xl border-2 border-gray-200 hover:border-primary-300 hover:text-primary-600 transition-all"
        >
          Guarda la demo
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
